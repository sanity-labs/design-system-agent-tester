{
  "name": "design-system-agent-tester",
  "version": "1.0.0",
  "description": "Test harness for measuring how well AI agents use a given design system. Runs many agents in parallel against the same brief and aggregates the results.",
  "type": "module",
  "main": "src/index.js",
  "keywords": [
    "ai",
    "agents",
    "design-system",
    "testing",
    "benchmarking",
    "anthropic",
    "claude"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "summarize": "node src/reporting/summarize.js",
    "new-test": "node src/scripts/new-test.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axe-core": "^4.11.1",
    "lighthouse": "^13.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.2.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "eslint-plugin-sanity-ui": "file:../../eslint-plugin-sanity-ui",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
