{
  "name": "agent-tester",
  "version": "1.0.0",
  "description": "Test harness for running AI agents in parallel to measure output consistency and quality",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "summarize": "node src/reporting/summarize.js",
    "rebuild": "node --env-file=.env src/scripts/rebuild.js",
    "rescreenshot": "node --env-file=.env src/scripts/rescreenshot.js",
    "reperf": "node src/scripts/reperf.js",
    "rediff": "node --env-file=.env src/scripts/rediff-all.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test --config src/evaluation/a11y/playwright.config.ts",
    "test:a11y:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axe-core": "^4.11.1",
    "lighthouse": "^13.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^24.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
